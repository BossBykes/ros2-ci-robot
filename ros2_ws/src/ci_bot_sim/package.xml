<?xml version="1.0"?>
<package format="3">
  <name>ci_bot_sim</name>
  <version>0.1.0</version>
  <description>Gazebo simulation environment for CI Bot.</description>

  <maintainer email="bossbykes@example.com">bossbykes</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ci_bot_control</exec_depend>
  <exec_depend>ci_bot_description</exec_depend>
  <exec_depend>ci_bot_fault_injection</exec_depend>
  <exec_depend>ci_bot_monitor</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
